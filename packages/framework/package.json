{
  "name": "@codexsun/framework",
  "version": "1.1.62",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./index.js"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./api.js"
    },
    "./addons": {
      "types": "./src/addons/index.ts",
      "default": "./addons.js"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "default": "./config.js"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./db.js"
    },
    "./env": {
      "types": "./src/env/index.ts",
      "default": "./env.js"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./errors.js"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "default": "./events.js"
    },
    "./health": {
      "types": "./src/health/index.ts",
      "default": "./health.js"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "default": "./http.js"
    },
    "./logger": {
      "types": "./src/logger/index.ts",
      "default": "./logger.js"
    },
    "./modules": {
      "types": "./src/modules/index.ts",
      "default": "./modules.js"
    },
    "./queue": {
      "types": "./src/queue/index.ts",
