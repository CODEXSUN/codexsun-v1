    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "default": "./storage.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "mariadb": "^3.5.4",
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  }
