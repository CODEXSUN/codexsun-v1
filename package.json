    "crm:mobile:apk:release": "node tools/crm-mobile.mjs build-release",
    "crm:mobile:analyze": "node tools/crm-mobile.mjs analyze",
    "crm:mobile:test": "node tools/crm-mobile.mjs test",
    "codexsun:mobile:run": "node tools/codexsun-mobile.mjs run",
    "codexsun:mobile:apk:debug": "node tools/codexsun-mobile.mjs build-debug",
    "codexsun:mobile:analyze": "node tools/codexsun-mobile.mjs analyze",
    "codexsun:mobile:test": "node tools/codexsun-mobile.mjs test",
    "clean:dist": "node tools/clean-root-dist.mjs",
    "test:module-boundaries": "node --test tools/check-module-boundaries.test.mjs",
    "check:component-docs": "node tools/check-component-docs.mjs",
    "test:component-docs": "node --test tools/check-component-docs.test.mjs",
    "docs:sync": "node tools/sync-repository-docs.mjs && node tools/check-docs-content.mjs --refresh-hashes",
    "dev:tconnect": "node tools/preflight.mjs tconnect-web",
    "build:tconnect": "npm run build -w @codexsun/tconnect-web",
    "test:tconnect": "node --import tsx --test apps/tconnect/api/src/tconnect.test.ts apps/tconnect/api/src/tconnect.members.test.ts apps/tconnect/api/src/tconnect.buyers.test.ts apps/tconnect/api/src/tconnect.negotiation.test.ts",
    "test:e2e:tconnect-journey": "node --import tsx tools/e2e/tconnect-account-browser.e2e.mjs",
    "test:e2e:tconnect-negotiation": "node --import tsx tools/e2e/tconnect-negotiation.e2e.ts",
    "test:e2e:tconnect-buyers": "node --import tsx tools/e2e/tconnect-buyer-access.e2e.ts",
    "test:e2e:tconnect": "node --import tsx tools/e2e/tconnect-member-access.e2e.ts"
