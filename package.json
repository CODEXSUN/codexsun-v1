    "test:sys-work": "tsx --test devkits/sys-work/api/src/cleaner.test.ts",
    "test:tenant-app-foundations": "node --import tsx --test apps/platform/web/src/app/tenant-app-foundations.test.ts tools/e2e/tenant-app-foundations.test.ts",
