    "test:e2e:frappe-mobile-customers": "node tools/ensure-framework-build.mjs && tsx --test tools/e2e/frappe-mobile-customers.e2e.ts",
    "test:e2e:crm-duties": "tsx --test tools/e2e/crm-duties.e2e.ts",
    "test:e2e:crm-frappe-sync-queue": "tsx --test tools/e2e/crm-frappe-sync-queue.e2e.ts",
