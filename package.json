{
  "name": "codexsun",
  "version": "1.1.82",
  "private": true,
  "packageManager": "npm@12.2.0",
  "description": "CODEXSUN",
  "type": "module",
  "workspaces": [
    "apps/*/*",
    "devkits/*",
    "devkits/*/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test:billing": "node tools/ensure-framework-build.mjs && node tools/billing-test-suite.mjs",
    "dev": "node tools/dev-stack.mjs",
    "dev:api": "node tools/preflight.mjs platform-api",
    "dev:web": "node tools/preflight.mjs platform-web",
    "dev:qcafe:api": "node tools/preflight.mjs qcafe-api",
    "dev:qcafe:web": "node tools/preflight.mjs qcafe-web",
    "dev:qcafe": "node tools/dev-qcafe.mjs",
    "build:qcafe": "npm run build -w @codexsun/qcafe-web",
    "build:qcafe:desktop": "npm run build -w @codexsun/qcafe-web -- --mode desktop",
    "dev:qcafe:windows": "npm run dev -w @codexsun/qcafe-desktop",
    "build:qcafe:windows": "npm run package:windows -w @codexsun/qcafe-desktop",
    "start:api:production": "node --import ./tools/register-production-package-resolution.mjs dist/apps/platform/api/server.js",
