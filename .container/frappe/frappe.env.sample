# No Frappe version is required. Installation resolves the latest stable release.
CODEXSUN_FRAPPE_SITE=erp.codexsun.localhost
CODEXSUN_FRAPPE_PORT=8088
CODEXSUN_FRAPPE_NETWORK=codexsun-network
# Required when the shared network is internal. Use an existing non-internal network.
# CODEXSUN_FRAPPE_ENTRY_NETWORK=codexsun-entry
CODEXSUN_FRAPPE_DB_HOST=codexsun-mariadb
CODEXSUN_FRAPPE_DB_PORT=3306
CODEXSUN_FRAPPE_DB_NAME=codexsun_frappe
CODEXSUN_FRAPPE_DB_PASSWORD='CHANGE_ME_database_root_password'
CODEXSUN_FRAPPE_REDIS_HOST=codexsun-redis
# Reserve unused Redis databases. Never use the application's queue database.
CODEXSUN_FRAPPE_REDIS_CACHE='redis://:CHANGE_ME@codexsun-redis:6379/10'
CODEXSUN_FRAPPE_REDIS_QUEUE='redis://:CHANGE_ME@codexsun-redis:6379/11'
CODEXSUN_FRAPPE_ADMIN_PASSWORD='CHANGE_ME_administrator_password'
