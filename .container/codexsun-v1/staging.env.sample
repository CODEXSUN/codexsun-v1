# Preparation only. VPS wrappers reject CODEXSUN_DEPLOY_TARGET=staging.
# Never copy production secrets, tenant registry credentials, or provider tokens.
CODEXSUN_DEPLOY_TARGET=staging
NODE_ENV=production
CODEXSUN_MARIADB_CONTAINER=codexsun-staging-mariadb
CODEXSUN_REDIS_CONTAINER=codexsun-staging-redis
CODEXSUN_DATA_VOLUME=codexsun-staging-data
CODEXSUN_MEDIA_DATA_VOLUME=codexsun-staging-media
CODEXSUN_DOCKER_NETWORK=codexsun-staging-network
CODEXSUN_REALTIME_ENABLED=0
# For a reviewed five-service candidate only: set realtime to 1 and provision a private token.
CODEXSUN_WORKER_PORT=28040
CODEXSUN_CHATB_PORT=28031
CODEXSUN_CHATB_UPSTREAM_URL=ws://codexsun-staging-api:28010
CODEXSUN_WORKER_CONTROL_TOKEN=
PLATFORM_API_PORT=28010
PLATFORM_WEB_PORT=28020
CODEXSUN_SHOP_PORT=28030
PLATFORM_WEB_ORIGIN=http://127.0.0.1:28020
DB_DRIVER=mariadb
DB_HOST=codexsun-staging-mariadb
DB_PORT=3306
DB_USER=codexsun_staging
DB_PASSWORD=change_this_isolated_staging_password
DB_MASTER_NAME=codexsun_staging_master
JWT_SECRET=change_this_isolated_staging_secret
CODEXSUN_REDIS_URL=redis://codexsun-staging-redis:6379/0
CODEXSUN_WORKER_QUEUE_PREFIX=codexsun-staging-worker
CODEXSUN_QUEUE_WORKER_ENABLED=0
MAIL_ENABLED=0
ENABLE_DEFAULT_TENANT_SEED=0
DEV_AUTO_TENANT_LOGIN=0
CODEXSUN_DB_FRESH_ON_START=0
CODEXSUN_ALLOW_PRODUCTION_DB_RESET=0
CODEXSUN_ALLOW_LIVE_RESTORE=0
# Fill only after exact staging migration review. This is not production approval.
CODEXSUN_MIGRATION_COMPATIBLE_VERSION=
