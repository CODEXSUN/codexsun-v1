# === Production runtime ===
CODEXSUN_DEPLOY_TARGET=vps
CODEXSUN_GIT_BRANCH=main
CODEXSUN_MARIADB_CONTAINER=codexsun-mariadb
CODEXSUN_REDIS_CONTAINER=codexsun-redis
CODEXSUN_REALTIME_ENABLED=0
NODE_ENV=production
PLATFORM_API_PORT=17010
PLATFORM_WEB_PORT=17020
CODEXSUN_SHOP_PORT=17030
PLATFORM_WEB_ORIGIN=https://app.codexsun.com

# === Container database connection ===
DB_DRIVER=mariadb
DB_HOST=codexsun-mariadb
DB_PORT=3306
DB_USER=codexsun
DB_PASSWORD=change_this_database_password
DB_MASTER_NAME=codexsun_master_db

# --- Database lifecycle ---
CODEXSUN_DB_FRESH_ON_START=0
CODEXSUN_DB_RESET_CONFIRM=
CODEXSUN_ALLOW_PRODUCTION_DB_RESET=0

# --- Database maintenance and backup/restore ---
CODEXSUN_BACKUP_DIR=storage/backups/database
CODEXSUN_RESTORE_TEST_DB_NAME=
# Supplied per operation after the deployment script verifies its backup.
CODEXSUN_VERIFIED_BACKUP_ID=
CODEXSUN_ALLOW_LIVE_RESTORE=0
CODEXSUN_LIVE_RESTORE_CONFIRM=

# === Queue and Redis ===
CODEXSUN_QUEUE_BACKEND=bullmq-redis
# Drain and stop the legacy executor before selecting worker in both services.
CODEXSUN_QUEUE_EXECUTION_HOST=platform
CODEXSUN_REDIS_URL=redis://codexsun-redis:6379/0

# === Mail fallback ===
MAIL_ENABLED=0
MAIL_SMTP_HOST=
# Use 465 with MAIL_SMTP_SECURE=1, or 587 with MAIL_SMTP_SECURE=0 for STARTTLS.
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CODEXSUN
MAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES=30
CODEXSUN_QUEUE_WORKER_ENABLED=1
CODEXSUN_QUEUE_WORKER_INTERVAL_MS=5000
CODEXSUN_QUEUE_COMPLETED_RETENTION_DAYS=14
CODEXSUN_QUEUE_FAILED_RETENTION_DAYS=30
CODEXSUN_WORKER_PORT=17040
CODEXSUN_WORKER_CONTROL_TOKEN=
CODEXSUN_WORKER_QUEUE_PREFIX=codexsun-worker
CODEXSUN_CHATB_PORT=17031
# Internal Docker URL. Do not expose the Platform API directly through this value.
CODEXSUN_CHATB_UPSTREAM_URL=ws://codexsun-api:17010

# === Default tenant ===
CODEXSUN_TENANCY_MODE=single
CODEXSUN_SINGLE_TENANT_CORPORATE_ID=CODEXSUN
ENABLE_DEFAULT_TENANT_SEED=1
DEV_AUTO_TENANT_LOGIN=0
TENANT_DOMAIN_BASE=codexsun.com
DEFAULT_TENANT_NAME=CODEXSUN
DEFAULT_TENANT_CORPORATE_ID=CODEXSUN
DEFAULT_TENANT_SLUG=codexsun
DEFAULT_TENANT_DB_NAME=codexsun_db
DEFAULT_TENANT_DOMAIN=app.codexsun.com
DEFAULT_TENANT_ADMIN_NAME=
DEFAULT_TENANT_ADMIN_EMAIL=
DEFAULT_TENANT_ADMIN_PASSWORD=

# === Authentication and sessions ===
JWT_SECRET=change_this_jwt_secret
AUTH_MODE=hybrid
# Keep 1 behind HTTPS. 0 is only for plain-HTTP LAN installs (cookie is not Secure).
AUTH_COOKIE_SECURE=1
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_RENEWAL_HOURS=24

# === WhiteBooks GST provider ===
GSP_ENVIRONMENT=sandbox
GSP_SANDBOX_BASE_URL=https://apisandbox.whitebooks.in
GSP_BASE_URL=https://api.whitebooks.in
GSP_EMAIL=
GSP_USERNAME=
GSP_PASSWORD=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_GSTIN=
GSP_IP_ADDRESS=0.0.0.0

# === Bootstrap users ===
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=

TENANT_ADMIN_NAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

# === Container storage paths ===
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public
TASK_MANAGER_JSON_DIR=storage/app/task-manager
CODEXSUN_DEVKIT_STORAGE_PATH=storage/app/devkit
CODEXSUN_DEVKIT_SYNC_ROLE=disabled
CODEXSUN_DEVKIT_SYNC_INSTANCE_ID=
CODEXSUN_DEVKIT_SYNC_TOKEN_PEPPER=
CODEXSUN_DEVKIT_SYNC_ENCRYPTION_KEY=
CODEXSUN_DEVKIT_SYNC_TEST_CLOUD_URL=
CODEXSUN_DEVKIT_WORKSPACE_ROOT=

# === Database tooling guards ===
CODEXSUN_DEV_SKIP_DB=0
CODEXSUN_RESTORED_DUMP_TEST=0
CODEXSUN_BACKUP_VERIFY_ID=

# === Deployment images and network ===
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.2.1
NGINX_BASE_IMAGE=nginx:1.28-alpine
CODEXSUN_VERSION=1.1.86
CODEXSUN_IMAGE_REGISTRY=codexsun
CODEXSUN_DOCKER_NETWORK=codexsun-network
CODEXSUN_BIND_ADDRESS=127.0.0.1

# === Guarded application updates ===
# Must match the source version after this release's migrations are reviewed as
# expand-contract and backward-compatible with the currently running image.
CODEXSUN_MIGRATION_COMPATIBLE_VERSION=1.1.61
CODEXSUN_UPDATE_MIN_BACKUP_FREE_MB=1024
CODEXSUN_UPDATE_MIN_DOCKER_FREE_MB=5120

# === MariaDB container ===
MARIADB_BASE_IMAGE=mariadb:11.8
MARIADB_IMAGE_TAG=11.8-codexsun-1.1.61
MARIADB_CLIENT_PATH=mariadb
MARIADB_ADMIN_USER=root
MARIADB_ROOT_PASSWORD=change_this_mariadb_root_password
MARIADB_BIND_ADDRESS=127.0.0.1
MARIADB_HOST_PORT=3307
MARIADB_DATA_VOLUME=codexsun-mariadb-data
MARIADB_BACKUP_VOLUME=codexsun-mariadb-backups

# === Redis container ===
REDIS_BASE_IMAGE=redis:7.4-alpine
REDIS_IMAGE_TAG=7.4-codexsun-1.0.45
REDIS_PASSWORD=change_this_redis_password
REDIS_HOST_PORT=6379
REDIS_DATA_VOLUME=codexsun-redis-data

# === File Browser container ===
FILEBROWSER_BASE_IMAGE=filebrowser/filebrowser:v2.63.5
MEDIA_IMAGE_TAG=1.1.61-filebrowser2.63.5
MEDIA_HOST_PORT=7090
MEDIA_ADMIN_USER=admin
MEDIA_ADMIN_PASSWORD=change_this_media_admin_password
MEDIA_DATA_VOLUME=codexsun-media-data
MEDIA_DB_VOLUME=codexsun-media-db

# === Application storage ===
CODEXSUN_DATA_VOLUME=codexsun-data

# === Public deployment hosts ===
CODEXSUN_WEB_HOST=app.codexsun.com
CODEXSUN_WEB_HOST_ALT=www.codexsun.com
CODEXSUN_MEDIA_HOST=files.codexsun.com

# Optional reviewed existing Media mount; empty preserves the single-volume layout.
CODEXSUN_MEDIA_DATA_VOLUME=
# Optional existing volume mounted read-only for CXApp Data Bridge imports.
CODEXSUN_DATA_BRIDGE_VOLUME=
