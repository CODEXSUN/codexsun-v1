# === Runtime ===
NODE_ENV=development
PLATFORM_API_PORT=7010
PLATFORM_WEB_PORT=7020
PLATFORM_WEB_ORIGIN=http://app.codexsun.test

# === Database connection ===
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_MASTER_NAME=

# --- Database lifecycle ---
# CODEXSUN_DB_FRESH_ON_START=1 drops and rebuilds configured databases on API startup.
# Destructive actions require CODEXSUN_DB_RESET_CONFIRM=DROP_DATABASES.
# Production additionally requires CODEXSUN_ALLOW_PRODUCTION_DB_RESET=1.
CODEXSUN_DB_FRESH_ON_START=0
CODEXSUN_DB_RESET_CONFIRM=
CODEXSUN_ALLOW_PRODUCTION_DB_RESET=0

# --- Database maintenance and backup/restore ---
CODEXSUN_BACKUP_DIR=storage/backups/database
CODEXSUN_RESTORE_TEST_DB_NAME=
CODEXSUN_VERIFIED_BACKUP_ID=
CODEXSUN_ALLOW_LIVE_RESTORE=0
CODEXSUN_LIVE_RESTORE_CONFIRM=

# === Queue ===
# Initial queue backend. Super Admin can switch at runtime between database and
# bullmq-redis. The selection is persisted in queue_runtime_settings.
CODEXSUN_QUEUE_BACKEND=database
CODEXSUN_REDIS_URL=redis://127.0.0.1:6379

# === Mail ===
# Default Mail fallback. Tenant company settings take priority when enabled.
MAIL_ENABLED=0
MAIL_SMTP_HOST=
# Use 465 with MAIL_SMTP_SECURE=1, or 587 with MAIL_SMTP_SECURE=0 for STARTTLS.
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CODEXSUN
MAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES=30
CODEXSUN_QUEUE_WORKER_ENABLED=1
CODEXSUN_QUEUE_WORKER_INTERVAL_MS=5000
CODEXSUN_QUEUE_COMPLETED_RETENTION_DAYS=14
CODEXSUN_QUEUE_FAILED_RETENTION_DAYS=30

# === Default tenant ===
# Select one mode before starting the API:
#   single: set CODEXSUN_TENANCY_MODE=single and set the registered client's Corporate ID.
#   multi: set CODEXSUN_TENANCY_MODE=multi and leave CODEXSUN_SINGLE_TENANT_CORPORATE_ID empty.
# In single mode, the ID must match DEFAULT_TENANT_CORPORATE_ID when seeding is enabled.
# Restart the API after changing modes; single mode requires exactly one active tenant.
CODEXSUN_TENANCY_MODE=multi
CODEXSUN_SINGLE_TENANT_CORPORATE_ID=
# Test-only default first tenant seed. Keep disabled for normal/live runtime.
# Set ENABLE_DEFAULT_TENANT_SEED=1 only for local smoke tests or e2e runs.
ENABLE_DEFAULT_TENANT_SEED=1
DEV_AUTO_TENANT_LOGIN=0
TENANT_DOMAIN_BASE=localhost
DEFAULT_TENANT_NAME=CODEXSUN
DEFAULT_TENANT_CORPORATE_ID=
DEFAULT_TENANT_SLUG=
DEFAULT_TENANT_DB_NAME=
DEFAULT_TENANT_DOMAIN=app.codexsun.test
DEFAULT_TENANT_ADMIN_NAME=
DEFAULT_TENANT_ADMIN_EMAIL=
DEFAULT_TENANT_ADMIN_PASSWORD=

# === Authentication and sessions ===
# REQUIRED. No fallback.
JWT_SECRET=

# === WhiteBooks GST provider ===
# Keep all credentials server-side; never expose them as VITE_* values.
GSP_ENVIRONMENT=sandbox
GSP_SANDBOX_BASE_URL=https://apisandbox.whitebooks.in
GSP_BASE_URL=https://api.whitebooks.in
GSP_EMAIL=
GSP_USERNAME=
GSP_PASSWORD=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_GSTIN=
GSP_IP_ADDRESS=0.0.0.0
# Optional product-specific keys for standalone E-way. Taxpayer details remain in GSP_*.
CODEXSUN_WHITEBOOKS_EWAY_CLIENT_ID=
CODEXSUN_WHITEBOOKS_EWAY_CLIENT_SECRET=
# Staged production product keys. Set real taxpayer GSP_* details before selecting production.
CODEXSUN_WHITEBOOKS_PRODUCTION_EINVOICE_CLIENT_ID=
CODEXSUN_WHITEBOOKS_PRODUCTION_EINVOICE_CLIENT_SECRET=
CODEXSUN_WHITEBOOKS_PRODUCTION_EWAY_CLIENT_ID=
CODEXSUN_WHITEBOOKS_PRODUCTION_EWAY_CLIENT_SECRET=


# Hybrid keeps browser sessions in an HttpOnly cookie while retaining bearer JWTs for API clients.
AUTH_MODE=hybrid
# Production session cookies are Secure (HTTPS only). Set 0 only for a plain-HTTP LAN install;
# the session cookie then travels unencrypted on that network.
AUTH_COOKIE_SECURE=1
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_RENEWAL_HOURS=24

# === Bootstrap users ===
# Optional first platform users. Leave blank on live and create users
# manually unless this deployment intentionally needs a seeded account.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=

# --- Tenant administrator bootstrap ---
# Optional tenant setup helper account. Leave blank on live unless you
# intentionally want every newly setup tenant to receive this admin user.
TENANT_ADMIN_NAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

# Outbound CRM enquiry sync to Frappe. Local CRM remains the system of record.
CODEXSUN_FRAPPE_ENABLED=0
CODEXSUN_FRAPPE_BASE_URL=
CODEXSUN_FRAPPE_APP_KEY=
CODEXSUN_FRAPPE_APP_SECRET=

# Zetro AI coworker. Base URL must be an OpenAI-compatible /v1 endpoint.
CODEXSUN_ZETRO_BASE_URL=https://api.openai.com/v1
CODEXSUN_ZETRO_API_KEY=
CODEXSUN_ZETRO_MODEL=
CODEXSUN_ZUNO_SOURCE_ROOT=
CODEXSUN_ZUNO_PLATFORM_LOG_PATH=
CODEXSUN_ZUNO_PROVIDER_BASE_URL=
CODEXSUN_ZUNO_PROVIDER_MODEL=
CODEXSUN_ZUNO_PROVIDER_API_KEY=

# === Storage ===
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public
# Optional one-time import path for legacy Task Manager JSON files. Runtime writes use MariaDB.
TASK_MANAGER_JSON_DIR=storage/app/task-manager

# === Development and tooling ===
# Dev preflight leaves active listeners and launchers running by default.
# Use "takeover" to replace a known CODEXSUN launcher, or "force" for any listener.
# CODEXSUN_DEV_PORT_POLICY=abort

# Set to 1 for faster local restarts when the database is already prepared.
# Skips the API database preflight and startup database bootstrap.
CODEXSUN_DEV_SKIP_DB=0

# Database safety command guards.
# Required for npm run db:migrations:test-local after restoring a dump locally.
CODEXSUN_RESTORED_DUMP_TEST=0

# Required for npm run db:backup:verify.
CODEXSUN_BACKUP_VERIFY_ID=

# Ecommerce frontend uses the composed Platform API
CODEXSUN_ECOMMERCE_WEB_PORT=7030

# Q Cafe stores one isolated database per cloud tenant under STORAGE_ROOT and
# keeps its cashier PIN as an app-level sign-in. The loopback API settings are
# used only by the legacy offline desktop development runtime.
CODEXSUN_QCAFE_API_PORT=4180
CODEXSUN_QCAFE_WEB_PORT=5180
CODEXSUN_QCAFE_DATABASE_PATH=apps/qcafe/.local/q-cafe.sqlite
CODEXSUN_QCAFE_IMAGE_DIRECTORY=apps/qcafe/.local/images

# Public Ecommerce storefront
CODEXSUN_UIUX_WEB_PORT=7040
CODEXSUN_CODEIT_WEB_PORT=7070
# Optional hosted Codeit address. Local launch links use port 7070 when empty.
CODEXSUN_CODEIT_WEB_URL=
CODEXSUN_SYS_WORK_WEB_PORT=7060
CODEXSUN_SYS_WORK_API_PORT=7061

# Client portfolio public sites
CODEXSUN_SITES_CODEXSUN_PORT=7130
CODEXSUN_SITES_LOGICX_PORT=7131
CODEXSUN_SITES_TECHMEDIA_PORT=7132

