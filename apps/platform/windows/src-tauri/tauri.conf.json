{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CODEXSUN",
  "version": "1.1.60",
  "identifier": "com.codexsun.codexsun",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:7060",
    "frontendDist": "../../../../dist/apps/platform/windows/web"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "CODEXSUN",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "copyright": "Copyright © CODEXSUN",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "longDescription": "CODEXSUN secure Windows desktop client.",
    "shortDescription": "CODEXSUN Windows client",
    "targets": [
      "nsis"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser"
      },
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CODEXSUN/codexsun/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2RjRCOEM0QkE1MUVFOTkKUldTWjdsRzZ4TGowVmhDT2o2blVoOEs1cEx4Ly9ydnp0bnNUekJpMStmM0laUWpoMXd6V3pLL1oK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
