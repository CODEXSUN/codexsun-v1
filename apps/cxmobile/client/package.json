    "@codexsun/core-web": "^1.1.76",
    "@codexsun/crm-web": "^1.1.76",
    "@codexsun/ecommerce-web": "^1.1.76",
    "@codexsun/platform-web": "^1.1.76",
    "@codexsun/ui": "^1.1.76",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
