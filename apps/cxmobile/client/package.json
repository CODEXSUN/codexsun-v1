    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "node --import ./test/register-test-env.mjs --import tsx --test test/billing-parity.test.ts test/chat-parity.test.ts test/crm-parity.test.ts test/docker-platform-acceptance.test.ts test/ecommerce-parity.test.ts test/http-transport.test.ts test/m2-slice.test.ts test/mobile-shell.test.ts test/native-capabilities.test.ts test/session-storage.test.ts test/tenant-session-isolation.test.ts test/websocket-transport.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@codexsun/billing-web": "^1.1.76",
